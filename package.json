{
	"name": "wintersky",
	"version": "2.0.0-oxygen.0",
	"description": "Bedrock-faithful Minecraft particle simulation and three.js renderer",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./render": "./src/render/index.ts"
	},
	"scripts": {
		"build": "tsup src/index.ts src/render/index.ts --format esm --dts --clean --target es2022",
		"test": "vitest run",
		"typecheck": "tsc --noEmit -p ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/JannisX11/wintersky.git"
	},
	"keywords": [
		"minecraft",
		"bedrock",
		"particles",
		"snowstorm",
		"blockbench"
	],
	"author": "JannisX11",
	"contributors": [
		"dev-hydrogen"
	],
	"license": "MIT",
	"dependencies": {
		"molangjs": "workspace:*"
	},
	"peerDependencies": {
		"three": ">=0.160.0"
	},
	"peerDependenciesMeta": {
		"three": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/three": "^0.186.0",
		"jsonc-parser": "^3.3.1",
		"three": "^0.186.1",
		"tsup": "^9.0.0",
		"typescript": "6.0.3",
		"vitest": "^5.0.5"
	}
}
